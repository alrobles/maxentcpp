#!/bin/sh

# Windows configure: detect terra include path and generate src/Makevars.win

TERRA_CPPFLAGS=""
TERRA_INCLUDE=`"${R_HOME}/bin/Rscript" -e "cat(system.file('include', package='terra'))" 2>nul`
if [ -n "${TERRA_INCLUDE}" ]; then
    TERRA_CPPFLAGS="-I${TERRA_INCLUDE}"
fi

sed -e "s|@TERRA_CPPFLAGS@|${TERRA_CPPFLAGS}|g" src/Makevars.in > src/Makevars.win
